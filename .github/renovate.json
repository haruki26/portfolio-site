{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":separatePatchReleases",
        ":label(dependencies)"
    ],
    "assignees": [
        "haruki26"
    ],
    "automerge": true,
    "enabledManagers": [
        "npm",
        "mise"
    ],
    "schedule": [
        "on Monday"
    ],
    "timezone": "Asia/Tokyo",
    "rangeStrategy": "pin",
    "packageRules": [
        {
            "matchManagers": [
                "npm"
            ],
            "postUpdateOptions": [
                "pnpmDedupe"
            ],
            "labels": [
                "dep:pnpm"
            ]
        },
        {
            "matchManagers": [
                "mise"
            ],
            "labels": [
                "dep:mise"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "groupName": "pnpm dependencies",
            "groupSlug": "pnpm-all",
            "matchPackageNames": [
                "!react",
                "!react-dom",
                "!@tanstack/react-start"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "automerge": true
        },
        {
            "matchPackageNames": [
                "react",
                "react-dom"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true
        },
        {
            "matchPackageNames": [
                "@tanstack/react-start"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true
        }
    ]
}
