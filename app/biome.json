{
    "$schema": "./../node_modules/@biomejs/biome/configuration_schema.json",
    "root": false,
    "extends": "//",
    "files": {
        "includes": [
            "src/**/*",
            "**/index.html",
            "!src/routeTree.gen.ts",
            "!src/styles.css"
        ]
    },
    "linter": {
        "rules": {
            "nursery": {
                "useTailwindSortedClasses": {
                    "fix": "safe",
                    "level": "error"
                }
            }
        }
    },
    "tailwind": { "mergeFunctions": ["twMerge", "clsx", "cn"] }
}
