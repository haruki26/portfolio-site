{
    "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
    "root": false,
    "extends": "//",
    "files": {
        "includes": [
            "src/**/*",
            "**/index.html",
            "vitest.config.ts",
            "!src/routeTree.gen.ts",
            "!src/styles.css"
        ]
    },
    "linter": {
        "rules": {
            "nursery": {
                "useSortedClasses": {
                    "fix": "safe",
                    "level": "error",
                    "options": {
                        "functions": ["twMerge", "clsx", "cn"]
                    }
                }
            }
        }
    }
}
