{
    "name": "portfolio-site",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev --port 3000",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "format": "biome format --write",
        "lint": "biome lint",
        "check": "biome check --write",
        "deploy": "pnpm run build && wrangler deploy",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "ci:check": "biome check",
        "ci:type": "tsc --noEmit",
        "prepare": "husky"
    },
    "dependencies": {
        "@cloudflare/vite-plugin": "^1.25.0",
        "@praha/byethrow": "^0.9.0",
        "@storybook/react-vite": "^10.2.8",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-devtools": "^0.7.11",
        "@tanstack/react-form": "^1.28.3",
        "@tanstack/react-query": "^5.90.21",
        "@tanstack/react-query-devtools": "^5.91.3",
        "@tanstack/react-router": "^1.160.2",
        "@tanstack/react-router-devtools": "^1.160.2",
        "@tanstack/react-router-ssr-query": "^1.160.2",
        "@tanstack/react-start": "^1.160.2",
        "@tanstack/router-plugin": "^1.160.2",
        "clsx": "^2.1.1",
        "dotenv": "^17.3.1",
        "html-react-parser": "^5.2.17",
        "lucide-react": "^0.545.0",
        "microcms-js-sdk": "^3.3.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-syntax-highlighter": "^16.1.0",
        "storybook": "^10.2.8",
        "tailwind-merge": "^3.4.1",
        "tailwindcss": "^4.1.18",
        "vite-tsconfig-paths": "^5.1.4",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.4",
        "@tailwindcss/typography": "^0.5.19",
        "@tanstack/devtools-vite": "^0.3.12",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.19.11",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^5.1.4",
        "@vitest/coverage-v8": "^4.0.18",
        "husky": "^9.1.7",
        "jsdom": "^27.4.0",
        "lint-staged": "^16.2.7",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "wrangler": "^4.65.0"
    },
    "lint-staged": {
        "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    }
}
