{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        /* Linting */
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        /* Monorepo */
        "composite": true,
        "incremental": true,
        "declarationMap": true
    }
}
